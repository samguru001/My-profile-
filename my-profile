<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Samguru — Front-End & Web3 Developer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #120A1F;
    --bg-2: #1B1030;
    --panel: #221639;
    --gold: #E8B84B;
    --gold-dim: #A8823A;
    --text: #EDE7F7;
    --muted: #9C8FBF;
    --line: rgba(232,184,75,0.18);
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background: radial-gradient(circle at 20% 0%, #1D1236 0%, var(--bg) 55%);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    line-height: 1.6;
    overflow-x: hidden;
  }
  ::selection{background: var(--gold); color:#12081F;}
  a{color:inherit;text-decoration:none;}

  .wrap{max-width: 980px; margin: 0 auto; padding: 0 28px;}

  /* NAV */
  header.nav{
    position: sticky; top:0; z-index: 50;
    backdrop-filter: blur(10px);
    background: rgba(18,10,31,0.75);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner{
    max-width: 980px; margin:0 auto; padding: 18px 28px;
    display:flex; align-items:center; justify-content:space-between;
  }
  .logo{
    font-family:'Space Grotesk'; font-weight:700; letter-spacing: 0.02em;
    font-size: 1.05rem; display:flex; align-items:center; gap:8px;
  }
  .logo .dot{width:8px;height:8px;border-radius:50%;background:var(--gold); box-shadow:0 0 10px var(--gold);}
  nav.links{display:flex; gap: 28px; font-size:0.88rem; color: var(--muted);}
  nav.links a{position:relative; transition: color 0.2s;}
  nav.links a:hover{color: var(--gold);}
  nav.links a.active{color: var(--gold);}
  nav.links a::after{
    content:''; position:absolute; bottom:-4px; left:0; width:0; height:1px;
    background:var(--gold); transition: width 0.25s ease;
  }
  nav.links a:hover::after, nav.links a.active::after{width:100%;}

  /* Mobile hamburger */
  .menu-toggle{
    display:none; flex-direction:column; gap:5px; cursor:pointer; padding:4px;
    background:none; border:none;
  }
  .menu-toggle span{
    display:block; width:22px; height:2px; background:var(--text);
    transition: transform 0.25s, opacity 0.25s;
  }
  .menu-toggle.open span:nth-child(1){transform: translateY(7px) rotate(45deg);}
  .menu-toggle.open span:nth-child(2){opacity:0;}
  .menu-toggle.open span:nth-child(3){transform: translateY(-7px) rotate(-45deg);}

  /* HERO */
  .hero{
    padding: 108px 0 96px;
    position: relative;
  }
  .chainline{
    font-family:'JetBrains Mono'; font-size: 0.72rem; letter-spacing:0.08em;
    color: var(--gold-dim); text-transform: uppercase;
    display:flex; align-items:center; gap:10px; margin-bottom: 28px;
  }
  .chainline::before{content:'';width:24px;height:1px;background:var(--gold-dim);}
  .hero h1{
    font-family:'Space Grotesk'; font-weight:700;
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    line-height: 1.05; letter-spacing:-0.01em;
    max-width: 760px;
  }
  .hero h1 span{color: var(--gold);}
  .hero p.sub{
    margin-top: 24px; max-width: 560px; color: var(--muted); font-size: 1.08rem;
  }
  .hero-cta{margin-top: 36px; display:flex; gap:16px; flex-wrap:wrap;}
  .btn{
    font-family:'Space Grotesk'; font-weight:600; font-size:0.92rem;
    padding: 13px 26px; border-radius: 2px; cursor:pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    display:inline-block;
  }
  .btn-primary{background: var(--gold); color:#1A0F2E; border:none;}
  .btn-primary:hover{transform: translateY(-2px); box-shadow: 0 8px 24px rgba(232,184,75,0.25);}
  .btn-ghost{background:transparent; border:1px solid var(--line); color: var(--text);}
  .btn-ghost:hover{border-color: var(--gold-dim);}

  /* ledger strip */
  .ledger{
    margin-top: 72px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
    display:grid; grid-template-columns: repeat(4,1fr);
  }
  .ledger div{
    padding: 20px 0; text-align:center; border-right: 1px solid var(--line);
  }
  .ledger div:last-child{border-right:none;}
  .ledger .num{font-family:'Space Grotesk'; font-weight:700; font-size:1.5rem; color:var(--gold);}
  .ledger .lbl{font-family:'JetBrains Mono'; font-size:0.68rem; color:var(--muted); text-transform:uppercase; letter-spacing:0.05em; margin-top:4px;}

  /* SECTION generic */
  section{padding: 88px 0;}
  .eyebrow{
    font-family:'JetBrains Mono'; font-size:0.72rem; color: var(--gold-dim);
    text-transform:uppercase; letter-spacing:0.08em; margin-bottom:14px;
    display:flex; align-items:center; gap:10px;
  }
  .eyebrow::before{content:'';width:24px;height:1px;background:var(--gold-dim);}
  h2{font-family:'Space Grotesk'; font-weight:700; font-size: clamp(1.6rem,3.4vw,2.2rem); margin-bottom: 12px;}
  .section-intro{color:var(--muted); max-width:600px; margin-bottom: 48px;}

  /* BLOCK CHAIN */
  .chain{display:flex; flex-direction:column;}
  .block{
    position:relative;
    background: var(--panel);
    border:1px solid var(--line);
    border-radius: 3px;
    padding: 32px;
    margin-bottom: 8px;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .block:hover{
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(232,184,75,0.08);
    border-color: rgba(232,184,75,0.35);
  }
  .block::before{
    content:'';
    position:absolute; left:31px; bottom:-8px; width:1px; height:8px;
    background: var(--gold-dim);
  }
  .chain .block:last-child::before{display:none;}
  .block-head{display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:8px; margin-bottom:14px;}
  .block-hash{font-family:'JetBrains Mono'; font-size:0.7rem; color:var(--gold-dim);}
  .block h3{font-family:'Space Grotesk'; font-size:1.25rem; font-weight:600;}
  .block p{color:var(--muted); margin-bottom: 16px; max-width: 640px;}
  .tags{display:flex; flex-wrap:wrap; gap:8px;}
  .tag{
    font-family:'JetBrains Mono'; font-size:0.7rem; color: var(--text);
    background: rgba(232,184,75,0.08); border:1px solid var(--line);
    padding: 5px 10px; border-radius: 2px;
    transition: background 0.2s, border-color 0.2s;
  }
  .tag:hover{background: rgba(232,184,75,0.15); border-color: var(--gold-dim);}

  /* SKILLS */
  .skill-grid{display:grid; grid-template-columns: repeat(auto-fit,minmax(200px,1fr)); gap:1px; background: var(--line); border:1px solid var(--line);}
  .skill-cell{background: var(--bg); padding: 24px; transition: background 0.25s;}
  .skill-cell:hover{background: var(--panel);}
  .skill-cell h4{font-family:'Space Grotesk'; font-size:0.95rem; color:var(--gold); margin-bottom:10px;}
  .skill-cell ul{list-style:none; color: var(--muted); font-size:0.9rem;}
  .skill-cell li{padding: 3px 0;}

  /* CONTACT */
  .contact-panel{
    background: linear-gradient(135deg, var(--panel), var(--bg-2));
    border:1px solid var(--line); border-radius:4px;
    padding: 48px; text-align:center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .contact-panel:hover{
    transform: translateY(-2px);
    box-shadow: 0 16px 40px rgba(232,184,75,0.06);
  }
  .contact-panel h2{margin-bottom:10px;}
  .contact-panel p{color:var(--muted); margin-bottom: 28px;}
  .contact-links{display:flex; gap:16px; justify-content:center; flex-wrap:wrap;}

  footer{
    border-top:1px solid var(--line); padding: 28px 0; text-align:center;
    font-family:'JetBrains Mono'; font-size:0.72rem; color: var(--muted);
  }

  /* SCROLL ANIMATIONS */
  .reveal{
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s cubic-bezier(0.16,1,0.3,1), transform 0.7s cubic-bezier(0.16,1,0.3,1);
  }
  .reveal.visible{
    opacity: 1;
    transform: translateY(0);
  }
  .reveal-delay-1{transition-delay: 0.1s;}
  .reveal-delay-2{transition-delay: 0.2s;}
  .reveal-delay-3{transition-delay: 0.3s;}
  .reveal-delay-4{transition-delay: 0.4s;}

  .block.reveal{transform: translateY(40px);}
  .block.reveal.visible{transform: translateY(0);}

  @media (max-width: 640px){
    .nav-inner{padding:16px 20px;}
    nav.links{
      display:none; position:absolute; top:100%; left:0; right:0;
      background: rgba(18,10,31,0.95); backdrop-filter: blur(10px);
      flex-direction:column; padding: 16px 28px; gap: 16px;
      border-bottom: 1px solid var(--line);
    }
    nav.links.open{display:flex;}
    .menu-toggle{display:flex;}
    .ledger{grid-template-columns: repeat(2,1fr);}
    .ledger div:nth-child(2){border-right:none;}
    section{padding: 56px 0;}
    .contact-panel{padding: 32px 20px;}
  }

  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    .btn, .block, .skill-cell, .contact-panel, .reveal{
      transition:none !important;
      transform:none !important;
      opacity:1 !important;
    }
  }
</style>
</head>
<body>

<header class="nav">
  <div class="nav-inner">
    <div class="logo"><span class="dot"></span>SAMGURU</div>
    <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </button>
    <nav class="links" id="navLinks">
      <a href="#work">Work</a>
